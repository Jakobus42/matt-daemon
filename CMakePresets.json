{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 2,
    "patch": 7
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MATT_DAEMON_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MATT_DAEMON_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "MATT_DAEMON_ENABLE_SANITIZER_ADDRESS": "ON",
        "MATT_DAEMON_ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "cacheVariables": {
        "MATT_DAEMON_ENABLE_SANITIZER_THREAD": "ON",
        "MATT_DAEMON_ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "analyze",
      "inherits": "debug",
      "cacheVariables": {
        "MATT_DAEMON_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "doc",
      "inherits": "base",
      "cacheVariables": {
        "MATT_DAEMON_ENABLE_DOC": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "analyze",
      "configurePreset": "analyze"
    },
    {
      "name": "doc",
      "configurePreset": "doc",
      "targets": [
        "doc"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": "base"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "inherits": "base"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "inherits": "base"
    }
  ]
}